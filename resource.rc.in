#include <winres.h>

1 ICON "omen_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @AMDOMEN_VER_RC@
PRODUCTVERSION  @AMDOMEN_VER_RC@
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AMDOMEN"
            VALUE "FileDescription",  "AMDOMEN Control"
            VALUE "FileVersion",      "@AMDOMEN_VERSION@"
            VALUE "InternalName",     "AMDOMEN"
            VALUE "OriginalFilename", "AMDOMEN.exe"
            VALUE "ProductName",      "AMDOMEN Control"
            VALUE "ProductVersion",   "@AMDOMEN_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
